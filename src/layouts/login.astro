---
import BaseLayout from '@layouts/base.astro';

//import { Image } from 'astro:assets';
//import LostPasswordIllustration from '@assets/illustrations/password_illustration.svg';
//import ProfilIllustration from '@assets/illustrations/profil_illustration.svg';
//import LoginIllustration from '@assets/illustrations/signin_illustration.svg';

interface Props {
	title?: string;
	description?: string;
	mode?: 'login' | 'profil' | 'lost-password' | 'reset-password';
}

const {
	title = 'Connexion / Inscription',
	description = 'Page de connexion / inscription à Your project',
	mode = 'login',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class='flex min-h-screen flex-col bg-white lg:flex-row lg:bg-transparent'>
		<aside class='flex flex-col lg:w-1/2'>
			{
				(mode === 'login' || mode === 'lost-password') && (
					<a class='title text-blue-saturated mt-12 ml-12 block font-medium' href='/'>
						Retour à l'accueil
					</a>
				)
			}
			<div class='relative flex-1 lg:min-h-150'>
				{
					/*<Image
					src={mode === 'login'
						? LoginIllustration
						: mode === 'profil'
							? ProfilIllustration
							: LostPasswordIllustration}
					class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 p-5 hidden lg:block'
					alt='Illustration de connexion'
					densities={[1.5, 2]}
					loading='eager'
				/>*/
				}
			</div>
		</aside>
		<main
			class='relative min-h-login w-full flex-1 bg-white p-12 lg:min-w-login lg:rounded-l-login lg:p-32 lg:w-1/2'>
			<slot />
		</main>
	</div>
</BaseLayout>

<style lang='scss'>
	body {
		background: var(--gradient-saturated-blue);
	}

	a.title {
		font-family: var(--title-font);
	}
</style>
