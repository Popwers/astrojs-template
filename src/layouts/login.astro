---
import BaseLayout from '@layouts/base.astro';

interface Props {
	title?: string;
	description?: string;
	mode?: 'login' | 'profil' | 'lost-password' | 'reset-password';
}

const {
	title = 'Connexion / Inscription',
	description = 'Page de connexion / inscription à Your project',
	mode = 'login',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class='flex min-h-screen flex-col bg-white lg:flex-row lg:bg-transparent'>
		<aside class='flex flex-col lg:w-1/2'>
			{
				(mode === 'login' || mode === 'lost-password') && (
					<a class='title text-blue-saturated mt-12 ml-12 block font-medium' href='/'>
						Retour à l'accueil
					</a>
				)
			}
			<div class='relative flex-1 lg:min-h-150'></div>
		</aside>
		<main
			class='relative min-h-login w-full flex-1 bg-white p-12 lg:min-w-login lg:rounded-l-login lg:p-32 lg:w-1/2'>
			<slot />
		</main>
	</div>
</BaseLayout>

<style lang='scss'>
	body {
		background: var(--gradient-saturated-blue);
	}

	a.title {
		font-family: var(--title-font);
	}
</style>
