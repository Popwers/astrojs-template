---
import '@styles/tailwind.css';
import '@styles/global.scss';
import '@styles/normalize.scss';
//import '@fontsource-variable/montserrat';
//import '@fontsource-variable/raleway';

import { ClientRouter } from 'astro:transitions';
import { pwaInfo } from 'virtual:pwa-info';
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';

import CookieBanner from '@components/site/global/CookieBanner.astro';

import { getSchemas } from '@lib/schema.org';
import { withPwaAssetVersion } from '@lib/pwaAssets';

import { enableReactComponents } from '@legendapp/state/config/enableReactComponents';
enableReactComponents();

interface Props {
	title?: string;
	description?: string;
}

const schemas = getSchemas(Astro.url);
const { title = 'Default title', description = 'Default description' } = Astro.props as Props;
const shouldRegisterPwa = import.meta.env.PROD || pwaInfo?.pwaInDevEnvironment;
const shouldCleanupDevServiceWorkers = import.meta.env.DEV;

// SPA view transitions (ClientRouter) are disabled on the dashboard because
// server:defer islands don't survive client-side navigation. Dashboard pages
// always do a full load. Only login/register pages use Astro transition:* directives.
const enableViewTransitions = !Astro.url.pathname.startsWith('/dashboard');
---

<!doctype html>
<html lang='fr'>
	<head>
		<SEO
			title={title}
			titleTemplate='Your project | %s'
			titleDefault='Your project'
			description={description}
			charset='utf-8'
			openGraph={{
				basic: {
					title: title,
					type: 'website',
					image: '/icon.png',
					url: Astro.url.href,
				},
				image: {
					alt: 'Your project logo',
				},
				optional: {
					siteName: 'Your project',
					locale: 'fr_FR',
				},
			}}
			twitter={{
				title: title,
				description: description,
				card: 'summary_large_image',
				site: '@yourproject',
				creator: '@yourproject',
				image: '/icon.png',
				imageAlt: 'Your project logo',
			}}
			extend={{
				link: [
					{ rel: 'icon', href: '/favicon.svg' },
					{ rel: 'apple-touch-icon', href: withPwaAssetVersion('/apple-touch-icon-180x180.png') },
					{ rel: 'sitemap', href: '/sitemap-index.xml' },
					{
						rel: 'manifest',
						href: withPwaAssetVersion('/manifest.webmanifest'),
						crossorigin: 'use-credentials',
					},
				],
				meta: [
					{ name: 'viewport', content: 'width=device-width, initial-scale=1' },
					{ name: 'theme-color', content: '#3936D9' },
					{ name: 'generator', content: Astro.generator },
				],
			}}
		/>

		{enableViewTransitions && <ClientRouter />}

		<Schema item={schemas.website} />
		<Schema item={schemas.organization} />

		{
			shouldCleanupDevServiceWorkers && (
				<script is:inline>
					{`if ('serviceWorker' in navigator) {
	window.addEventListener('load', async () => {
		const registrations = await navigator.serviceWorker.getRegistrations();
		await Promise.all(registrations.map(registration => registration.unregister()));

		if ('caches' in window) {
			const cacheKeys = await caches.keys();
			await Promise.all(cacheKeys.map(cacheKey => caches.delete(cacheKey)));
		}
	});
}`}
				</script>
			)
		}
		{shouldRegisterPwa && <script src='/src/pwa.ts'></script>}
		{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
	</head>

	<body>
		<slot />
		<CookieBanner />
	</body>
</html>
