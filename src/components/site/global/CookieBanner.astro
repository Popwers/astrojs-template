<div id='cookie-banner' class='cookie-layer cookie-banner fixed bottom-4 left-4 z-50 w-[calc(100%-2rem)] rounded-2xl bg-white p-10 shadow-2xl xl:w-1/3'>
	<p class='h3'>🍪 Nous respectons votre vie privée !</p>
	<p class='mb-10'>
		Your project utilise des cookies essentiels pour assurer son bon fonctionnement. Pour améliorer nos
		services, nous proposons également d'utiliser des cookies d'analyse qui nous permettent de comprendre
		comment vous utilisez notre site. Ces derniers ne seront activés qu'avec votre consentement explicite.
		Pour plus d'informations, consultez notre <a class='underline' href='/politique-confidentialite'
			>politique de confidentialité</a
		>.
	</p>
	<div class='flex gap-4'>
		<button id='customize-cookies' class='tertiary fit w-full'>Personnaliser</button>
		<button id='accept-all-cookies' class='fit w-full'>Tout accepter</button>
	</div>
</div>

<div id='cookie-modal' class='cookie-layer cookie-modal fixed inset-0 z-50 bg-black/50'>
	<div
		class='fixed top-1/2 left-1/2 w-full max-w-4xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-10 shadow-2xl'>
		<p class='h3'>Paramètres des cookies</p>

		<ul class='mb-10 list-none'>
			<li>
				<p class='text-blue-dark mb-0 font-medium'>Cookies essentiels</p>
				<div class='flex items-center justify-between gap-4'>
					<p class='mt-0 text-sm text-gray-600'>
						Ces cookies sont indispensables au fonctionnement du site. Ils permettent
						l'utilisation des fonctionnalités de base comme la navigation et l'accès aux espaces
						sécurisés. Le site ne peut pas fonctionner correctement sans ces cookies.
					</p>
					<label for='functional-cookies' class='flex cursor-not-allowed items-center gap-2'>
						<input
							type='checkbox'
							id='functional-cookies'
							class='cursor-not-allowed'
							checked
							disabled
						/>
						<span class='mt-0 text-sm text-gray-600'>Activer</span>
					</label>
				</div>
			</li>
			<li>
				<p class='text-blue-dark mb-0 font-medium'>Cookies d'analyse</p>
				<div class='flex items-center justify-between gap-4'>
					<p class='mt-0 text-sm text-gray-600'>
						Ces cookies nous permettent de mesurer l'audience de notre site, de voir quelles pages
						sont les plus consultées et comment le site est utilisé. Toutes ces informations sont
						anonymes et nous aident à améliorer votre expérience. Vous pouvez désactiver ces
						cookies sans impact sur votre navigation.
					</p>
					<label for='analytics-cookies' class='flex cursor-pointer items-center gap-2'>
						<input type='checkbox' id='analytics-cookies' class='cursor-pointer' checked />
						<span class='mt-0 text-sm text-gray-600'>Activer</span>
					</label>
				</div>
			</li>
		</ul>

		<div class='flex justify-end'>
			<button id='save-preferences' class='primary fit'>Enregistrer les préférences</button>
		</div>
	</div>
</div>

<style>
	.cookie-layer {
		opacity: 0;
		pointer-events: none;
	}

	.cookie-banner {
		transform: translateY(2.5rem) scale(0.95);
		transition:
			opacity 200ms ease-out,
			transform 200ms ease-out;
	}

	.cookie-modal {
		transition: opacity 200ms ease-out;
	}

	.cookie-layer.is-visible {
		opacity: 1;
		pointer-events: auto;
	}

	.cookie-banner.is-visible {
		transform: translateY(0) scale(1);
	}
</style>

<script>
	import { hasStoredConsent, updateConsent } from '@stores/consentStore';

	const init = () => {
		const banner = document.querySelector<HTMLDivElement>('#cookie-banner');
		const modal = document.querySelector<HTMLDivElement>('#cookie-modal');
		const customizeBtn = document.querySelector<HTMLButtonElement>('#customize-cookies');
		const acceptAllBtn = document.querySelector<HTMLButtonElement>('#accept-all-cookies');
		const savePreferencesBtn = document.querySelector<HTMLButtonElement>('#save-preferences');
		const analyticsCheckbox = document.querySelector<HTMLInputElement>('#analytics-cookies');

		if (!banner || !modal || !analyticsCheckbox) return;

		if (banner.classList.contains('init')) return;
		banner.classList.add('init');

		acceptAllBtn?.addEventListener('click', () => {
			updateConsent({
				functional: true,
				analytics: true,
			});
			banner.classList.remove('is-visible');
		});

		customizeBtn?.addEventListener('click', () => {
			banner.classList.remove('is-visible');
			modal.classList.add('is-visible');
		});

		savePreferencesBtn?.addEventListener('click', () => {
			updateConsent({
				functional: true,
				analytics: analyticsCheckbox.checked,
			});
			modal.classList.remove('is-visible');
		});

		if (!hasStoredConsent()) {
			setTimeout(() => {
				banner.classList.add('is-visible');
			}, 4000);
		}
	};

	init();
	document.addEventListener('astro:page-load', init);
</script>
