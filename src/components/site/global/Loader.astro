---
interface Props {
	class?: string;
	dotsColor?: string;
}

const { class: className, dotsColor = 'current', ...props } = Astro.props;

const delayClasses = ['delay-bounce-0', 'delay-bounce-1', 'delay-bounce-2'] as const;
---

<div {...props} class={`flex justify-center items-center space-x-2 h-[3.4rem] ${className}`}>
	{
		delayClasses.map(delayClass => (
			<span
				class={`inline-block w-1.5 h-1.5 bg-${dotsColor} rounded-full animate-bounce duration-700 transition-discrete ${delayClass}`}
			/>
		))
	}
</div>
