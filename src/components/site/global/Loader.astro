---
import { cn } from '@lib/utils';

interface Props {
	class?: string;
	dotsColor?: 'current' | 'white';
}

const { class: className, dotsColor = 'current', ...props } = Astro.props;

const delayClasses = ['delay-bounce-0', 'delay-bounce-1', 'delay-bounce-2'] as const;
const dotColorClass = dotsColor === 'white' ? 'bg-white' : 'bg-current';
---

<div {...props} class={cn('flex h-loader items-center justify-center space-x-2', className)}>
	{
		delayClasses.map((delayClass) => (
			<span
				class={cn(
					'inline-block h-1.5 w-1.5 animate-bounce rounded-full duration-700 transition-discrete',
					dotColorClass,
					delayClass,
				)}
			/>
		))
	}
</div>
