---
import { actions, isInputError } from 'astro:actions';

import ErrorInput from '@components/site/global/input/ErrorInput.astro';
import PasswordChecker from '@components/site/global/input/PasswordChecker.tsx';
import ReturnInfo from '@components/site/global/input/ReturnInfo.astro';
import SubmitButton from '@components/site/global/input/SubmitButton';
import LoginLayout from '@layouts/login.astro';

import DEFAULT_COOKIE_OPTIONS from '@data/cookieOptions';
import { isStrapiUserData } from '@lib/strapi';
import { updateUserCookie } from '@lib/userCookie';

const RESET_CODE_COOKIE = 'password-reset-code';

const result = Astro.getActionResult(actions.password.resetPassword);
if (result && !result.error) {
	if (!isStrapiUserData(result.data)) {
		console.error('Password reset succeeded but payload is missing jwt/user — likely upstream API returned non-JSON.');
		return Astro.redirect('/login?error=server-unavailable');
	}
	const { jwt, user } = result.data;
	Astro.cookies.set('user_token', jwt, DEFAULT_COOKIE_OPTIONS);
	Astro.locals.user = updateUserCookie(Astro.cookies, user);
	Astro.cookies.delete(RESET_CODE_COOKIE, { path: '/' });

	return Astro.redirect('/dashboard');
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {};

const codeFromQuery = Astro.url.searchParams.get('code');
if (codeFromQuery) {
	Astro.cookies.set(RESET_CODE_COOKIE, codeFromQuery, {
		...DEFAULT_COOKIE_OPTIONS,
		maxAge: 60 * 15,
		expires: new Date(Date.now() + 1000 * 60 * 15),
	});
	return Astro.redirect('/lost-password/reset');
}

const code = Astro.cookies.get(RESET_CODE_COOKIE)?.value;
if (!code) return Astro.redirect('/lost-password');
---

<LoginLayout
	title='Changer votre mot de passe'
	description='Changer votre mot de passe pour accéder à votre compte'
	mode='reset-password'>
	<h1 class='h3'>Changer votre mot de passe</h1>

	<form class='mt-16' method='POST' action={actions.password.resetPassword}>
		<input type='hidden' name='code' value={code} />

		<div class='form-group'>
			<label for='password'>Nouveau mot de passe</label>
			<input type='password' id='password' name='password' autocomplete='new-password' required />
			<ErrorInput errors={inputErrors.password} />
			<PasswordChecker client:idle />
		</div>

		<div class='form-group'>
			<label for='passwordConfirmation'>Confirmer le mot de passe</label>
			<input
				type='password'
				id='passwordConfirmation'
				name='passwordConfirmation'
				autocomplete='new-password'
				required
			/>
			<ErrorInput errors={inputErrors.passwordConfirmation} />
		</div>

		<ReturnInfo result={result} />

		<SubmitButton client:idle className='mt-12 w-full' label='Changer mon mot de passe' />
	</form>
</LoginLayout>
