---
// On demand, cached at the edge: the text comes from Strapi per request, so an edit shows within a day
// (s-maxage, see the page-cache middleware) without a rebuild, and the build needs neither Strapi nor
// the runtime secrets. Content falls back to empty array when Strapi is unreachable.
export const prerender = false;

import TextRenderer from "@components/site/global/TextRenderer";
import type TextPage from "@interfaces/textPage";
import DefaultLayout from "@layouts/index.astro";
import { PRIVATE_CACHE_CONTROL } from "@lib/pageCache";
import fetchApi from "@lib/strapi";

const data = await fetchApi<TextPage>({
	endpoint: "politique-confidentialite",
	query: { fields: "Contenu" },
});
const content = data?.Contenu ?? [];
// A Strapi miss renders an empty page: keep that copy out of the edge cache.
if (content.length === 0) Astro.response.headers.set('Cache-Control', PRIVATE_CACHE_CONTROL);

const title: string = "Politique de confidentialité";
const description: string = "Page de la politique de confidentialité du site";
---

<DefaultLayout title={title} description={description}>
	<h1>{title}</h1>
	<div class='mb-16 lg:mb-32'>
		<TextRenderer content={content} />
	</div>
</DefaultLayout>
