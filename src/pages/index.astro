---
import { Picture } from 'astro:assets';

import hero from '@assets/images/hero.jpg';
import DefaultLayout from '@layouts/index.astro';

const title: string = 'Accueil';
const description: string = "Descrption page d'accueil";
---

<DefaultLayout title={title} description={description}>
	{/* LCP image: AVIF then WebP with a JPEG fallback, sized per viewport; `priority` sets
	loading="eager" and fetchpriority="high". Only one per page. Replace hero.jpg with a real photo. */}
	<Picture
		src={hero}
		formats={['avif', 'webp']}
		widths={[640, 960, 1280, 1600]}
		sizes='(min-width: 1280px) 1200px, 100vw'
		alt=''
		priority
		class='hero'
	/>
	<h1 class=''>Welcome to <span class='text-gradient'>Astro</span></h1>
	<p class='instructions'>
		To get started, open the directory <code>src/pages</code> in your project.<br />
		<strong>Code Challenge:</strong> Tweak the "Welcome to Astro" message above.
	</p>
</DefaultLayout>

<style lang='scss'>
	html {
		margin: auto;
		padding: 1rem;
		color: white;
		line-height: 1.6;
		text-align: center;
		background-color: var(--blue-light);
	}

	.hero {
		width: 100%;
		height: auto;
		margin: 0 auto 4rem;
		border-radius: 1rem;
	}
</style>
