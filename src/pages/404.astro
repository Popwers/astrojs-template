---
// SSR 404: a prerendered 404.html is served as a host-canonical redirect to
// `site` (https://your-project.fr/404) instead of the custom error page.
export const prerender = false;

import DefaultLayout from '@layouts/index.astro';

const title: string = 'Page non trouvée';
const description: string = "La page que vous recherchez n'existe pas";
---

<DefaultLayout title={title} description={description}>
	<main class='flex flex-col items-center justify-center min-h-40 h-dvh text-center px-4'>
		<h1 class='text-4xl font-bold mb-4'>Page non trouvée</h1>
		<p class='mb-8'>{description}</p>
		<a href='/' class='btn secondary'> Retourner à l'accueil </a>
	</main>
</DefaultLayout>
