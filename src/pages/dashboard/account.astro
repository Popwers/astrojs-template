---
import { actions, isInputError } from 'astro:actions';

import Avatar from '@components/site/global/Avatar.astro';
import AvatarInput from '@components/site/global/input/AvatarInput';
import ErrorInput from '@components/site/global/input/ErrorInput.astro';
import ReturnInfo from '@components/site/global/input/ReturnInfo.astro';
import SubmitButton from '@components/site/global/input/SubmitButton';
import DashboardLayout from '@layouts/dashboard.astro';

import { clearUserSession } from '@lib/session';
import { updateUserCookie } from '@lib/userCookie';

import type { User } from '@interfaces/user';

// A successful account deletion tears down the session and bounces to the home page.
const deleteResult = Astro.getActionResult(actions.user.deleteAccount);
if (deleteResult && !deleteResult.error) {
	clearUserSession(Astro);
	return Astro.redirect('/');
}

const result = Astro.getActionResult(actions.user.update);
if (result && !result.error) {
	const updatedUser = result.data.user as User;
	Astro.locals.user = updateUserCookie(Astro.cookies, updatedUser) as User;
}
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const deleteError = deleteResult?.error?.message ?? null;

const { username, email } = Astro.locals.user ?? {};
const title: string = 'Mon profil';
const description: string = 'Modifier mes informations personnelles';
---

<DashboardLayout title={title} description={description} dashboardTitle={title}>
	<ReturnInfo result={result} box={true} successMessage='Vos informations ont bien été mises à jour' />

	<AvatarInput client:only='react'>
		<Avatar blueIcon />
	</AvatarInput>

	<form method='POST' action={actions.user.update}>
		<div class='flex flex-col lg:flex-row lg:gap-6 mt-12'>
			<div class='form-group w-full'>
				<label for='username'>Nom</label>
				<input
					type='text'
					id='username'
					value={username}
					name='username'
					autocomplete='family-name'
					placeholder='Nom prénom ou dénomination'
					required
				/>
				<ErrorInput errors={inputErrors.username} />
			</div>
		</div>
		<div class='flex flex-col lg:flex-row lg:gap-6'>
			<div class='form-group w-full'>
				<label for='email'>Adresse mail</label>
				<input
					type='email'
					inputmode='email'
					id='email'
					value={email}
					name='email'
					autocomplete='username'
					placeholder='votre@email.com'
					required
				/>
				<ErrorInput errors={inputErrors.email} />
			</div>
		</div>

		<SubmitButton client:idle className='mt-12' label='Enregistrer' />
	</form>

	<section class='border-red mt-16 rounded-lg border p-6'>
		<h2 class='text-red text-xl font-medium'>Zone de danger</h2>
		<p class='mt-2 text-sm'>
			La suppression de votre compte est définitive et irréversible. Toutes vos données seront
			effacées.
		</p>

		{deleteError && <p class='text-red mt-4 text-sm'>{deleteError}</p>}

		<form method='POST' action={actions.user.deleteAccount} class='mt-6'>
			<div class='form-group flex items-start gap-3'>
				<input type='checkbox' id='confirmation' name='confirmation' value='true' required />
				<label for='confirmation' class='text-sm'>
					Je comprends que cette action est définitive et je souhaite supprimer mon compte.
				</label>
			</div>

			<SubmitButton
				client:idle
				className='mt-6 w-full bordered !border-red !text-red'
				label='Supprimer définitivement mon compte'
			/>
		</form>
	</section>
</DashboardLayout>
