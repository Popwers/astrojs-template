STRAPI_URL=
STRAPI_TOKEN=
# Required. The process throws if this is unset.
COOKIE_SIGNING_SECRET=

# Unset: rate limits use the socket address and ignore spoofable forwarded headers.
# cloudflare: use CF-Connecting-IP. 1 / forwarded: use X-Forwarded-For / X-Real-IP.
TRUST_PROXY=

# Sentry: build-time token for source map upload. Not needed at runtime.
# Pass it to Docker as a BuildKit secret, never as a build ARG or ENV.
SENTRY_AUTH_TOKEN=
# Sentry release: set to the deployed git SHA in the build env so errors
# map to the commit that introduced them (the vite plugin reads it automatically).
SENTRY_RELEASE=
