#!/usr/bin/env bash
# Agent harness for astrojs-template. Invoke from the repo root.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
SKILL_DIR="$ROOT/.cursor/skills/verify-astrojs"
TMP_DIR="${ASTROJS_VERIFY_TMP:-/tmp/verify-astrojs}"
STATE_FILE="$TMP_DIR/state"
ENV_FILE="$TMP_DIR/run.env"
LOG_FILE="$TMP_DIR/astro.log"
STUB_LOG_FILE="$TMP_DIR/strapi-stub.log"
PID_FILE="$TMP_DIR/pid"
PROOF_DIR="${ASTROJS_VERIFY_EVIDENCE_DIR:-$SKILL_DIR/proof}"
DEFAULT_PORT="${ASTROJS_VERIFY_PORT:-4331}"
# Below the kernel ephemeral range (32768+), where a TIME-WAIT client socket can hold the port,
# and above the app's 4331-4351 pick range.
DEFAULT_STUB_PORT="${ASTROJS_VERIFY_STUB_PORT:-4381}"

export PATH="${HOME}/.local/bin:${HOME}/.bun/bin:${HOME}/.local/node22/bin:${PATH}"

usage() {
	cat <<'EOF'
control-astrojs <command>

Commands:
  launch [--port N] [--json]          Start the Strapi stub + isolated astro dev
  doctor [--json]                     Read-only health check (exit 0 = driveable)
  http GET PATH [--no-follow]         Request against the owned origin
       [--body FILE] [--headers FILE]  Also save the response body / headers
  screenshot --path FILE [--url /p]   Headless Chrome PNG
  drive FEATURE                       Scripted recipe + proof/<feature>/ (public-home,
                                      auth-login, auth-register, lost-password)
  cleanup                             Stop what launch started (keep proof/)
  self-check                          CLI smoke without starting the app
  help                                Show this text

Env:
  ASTROJS_VERIFY_PORT           default 4331
  ASTROJS_VERIFY_STUB_PORT      default 4381
  ASTROJS_VERIFY_TMP            default /tmp/verify-astrojs
  ASTROJS_VERIFY_EVIDENCE_DIR   default <skill>/proof
EOF
}

die() {
	echo "control-astrojs: $*" >&2
	exit 1
}

pid_alive() {
	kill -0 "$1" 2>/dev/null
}

list_descendants() {
	local children child
	children="$(pgrep -P "$1" 2>/dev/null || true)"
	for child in $children; do
		list_descendants "$child"
		printf '%s ' "$child"
	done
}

stop_pid_tree() {
	local root="$1"
	local descendants
	descendants="$(list_descendants "$root")"
	# Intentional word-split of the descendant pid list.
	# shellcheck disable=SC2086
	kill -TERM $descendants "$root" 2>/dev/null || true
	local deadline=$((SECONDS + 10))
	while [ "$SECONDS" -lt "$deadline" ] && pid_alive "$root"; do
		sleep 0.2
	done
	if pid_alive "$root"; then
		# shellcheck disable=SC2086
		kill -KILL $descendants "$root" 2>/dev/null || true
	fi
}

port_in_use() {
	local port="$1"
	python3 - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket()
s.settimeout(0.3)
try:
    s.connect(("127.0.0.1", port))
except OSError:
    sys.exit(1)
else:
    s.close()
    sys.exit(0)
PY
}

# A port nobody listens on can still be unbindable (TIME-WAIT), so pick by binding.
port_bindable() {
	python3 - "$1" <<'PY'
import socket, sys
s = socket.socket()
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

ensure_node() {
	local vp_node="" candidate ver major
	if command -v vp >/dev/null 2>&1; then
		case "$(command -v vp)" in
		*/node_modules/.bin/vp) ;;
		*)
			vp_node="$(vp env which node 2>/dev/null | awk 'NR==1 { print; exit }')" || true
			;;
		esac
	fi
	if [ -n "$vp_node" ] && [ -x "$vp_node" ]; then
		export PATH="$(dirname "$vp_node"):${PATH}"
	fi
	for candidate in \
		"${HOME}/.local/share/vite-plus/js_runtime/node/24.21.0/bin" \
		"${HOME}/.local/share/vite-plus/js_runtime/node/22.23.2/bin" \
		"${HOME}/.local/node22/bin" \
		"${HOME}/.local/node/bin"; do
		if [ -x "${candidate}/node" ]; then
			export PATH="${candidate}:${PATH}"
			break
		fi
	done
	ver="$(node -v 2>/dev/null || true)"
	major="$(printf '%s' "${ver#v}" | awk -F. '{ print $1 + 0 }')"
	[ "${major:-0}" -ge 22 ] || die "need Node >=22.12 (got ${ver:-missing}); install via vp env"
}

ensure_deps() {
	if [ ! -d "$ROOT/node_modules" ] || [ ! -x "$ROOT/node_modules/.bin/astro" ]; then
		command -v bun >/dev/null 2>&1 || die "missing bun"
		(cd "$ROOT" && bun install)
	fi
	[ -x "$ROOT/node_modules/.bin/astro" ] || die "astro binary missing after install"
}

load_state() {
	[ -f "$STATE_FILE" ] || die "no state file at $STATE_FILE (run launch first)"
	# shellcheck disable=SC1090
	. "$STATE_FILE"
	[ -n "${PORT:-}" ] || die "state is missing PORT"
	[ -n "${PID:-}" ] || die "state is missing PID"
	[ -n "${STUB_PID:-}" ] || die "state is missing STUB_PID (relaunch)"
}

origin() {
	printf 'http://127.0.0.1:%s' "${PORT:?}"
}

write_state() {
	mkdir -p "$TMP_DIR"
	cat >"$STATE_FILE" <<EOF
PID=$1
PORT=$2
STUB_PID=$3
STUB_PORT=$4
STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
REPO=$ROOT
LOG=$LOG_FILE
ORIGIN=http://127.0.0.1:$2
OWNED=1
EOF
	printf '%s\n' "$1" >"$PID_FILE"
}

pick_port() {
	local start="$1" port
	port="$start"
	while [ "$port" -le $((start + 20)) ]; do
		if [ "$port" -eq 4321 ]; then
			port=$((port + 1))
			continue
		fi
		if ! port_in_use "$port" && port_bindable "$port"; then
			printf '%s\n' "$port"
			return 0
		fi
		port=$((port + 1))
	done
	die "no free port in ${start}-$((start + 20)) (skipping 4321)"
}

wait_ready() {
	local port="$1" launch_pid="${2:-}"
	local deadline=$((SECONDS + 90)) status
	while [ "$SECONDS" -lt "$deadline" ]; do
		if [ -n "$launch_pid" ] && ! pid_alive "$launch_pid"; then
			die "astro process $launch_pid exited before ready (see $LOG_FILE)"
		fi
		status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${port}/login" 2>/dev/null || true)"
		case "$status" in
		[1-4][0-9][0-9]) return 0 ;;
		esac
		sleep 0.5
	done
	die "app did not become ready on :$port (see $LOG_FILE)"
}

# Any HTTP answer (even a 401) proves the stub listens.
wait_stub_ready() {
	local port="$1" stub_pid="$2"
	local deadline=$((SECONDS + 20))
	while [ "$SECONDS" -lt "$deadline" ]; do
		pid_alive "$stub_pid" || return 1
		curl -s -o /dev/null --max-time 2 "http://127.0.0.1:${port}/api/users/me" && return 0
		sleep 0.2
	done
	return 1
}

cmd_launch() {
	local want_json=0 requested="" port stub_port secret
	while [ $# -gt 0 ]; do
		case "$1" in
		--json) want_json=1; shift ;;
		--port)
			[ $# -ge 2 ] || die "--port needs a value"
			requested="$2"
			shift 2
			;;
		*) die "unknown launch flag: $1" ;;
		esac
	done

	if [ -f "$STATE_FILE" ]; then
		# shellcheck disable=SC1090
		. "$STATE_FILE"
		if [ -n "${PID:-}" ] && pid_alive "$PID" && [ -n "${PORT:-}" ] && port_in_use "$PORT"; then
			if [ -n "$requested" ] && [ "$requested" != "$PORT" ]; then
				die "already launched pid=$PID port=$PORT; cleanup first or omit --port"
			fi
			if [ "$want_json" -eq 1 ]; then
				python3 -c 'import json,os; print(json.dumps({"pid":os.environ["PID"],"port":int(os.environ["PORT"]),"origin":os.environ["ORIGIN"],"owned":True}))' \
					2>/dev/null || true
			fi
			printf 'already launched pid=%s port=%s origin=%s\n' "$PID" "$PORT" "$(origin)"
			cmd_doctor >/dev/null
			return 0
		fi
		if [ -n "${PID:-}" ] && pid_alive "$PID"; then
			die "another verify-astrojs instance is running (pid=$PID port=${PORT:-unknown}). cleanup first"
		fi
	fi

	if [ -n "$requested" ]; then
		port_in_use "$requested" && die "port $requested is already in use and is not this run"
		port="$requested"
	else
		port="$(pick_port "$DEFAULT_PORT")"
	fi

	stub_port="$(pick_port "$DEFAULT_STUB_PORT")"

	ensure_node
	ensure_deps
	command -v openssl >/dev/null 2>&1 || die "missing openssl"
	secret="$(openssl rand -hex 32)"

	mkdir -p "$TMP_DIR" "$PROOF_DIR"
	: >"$LOG_FILE"
	(
		cd "$ROOT"
		STRAPI_STUB_PORT="$stub_port" exec bun tests/e2e/strapi-stub.ts
	) >"$STUB_LOG_FILE" 2>&1 </dev/null &
	local stub_pid=$!
	if ! wait_stub_ready "$stub_port" "$stub_pid"; then
		stop_pid_tree "$stub_pid"
		die "Strapi stub did not answer on :$stub_port (see $STUB_LOG_FILE)"
	fi
	cat >"$ENV_FILE" <<EOF
COOKIE_SIGNING_SECRET=$secret
STRAPI_URL=http://127.0.0.1:$stub_port
STRAPI_TOKEN=verify-stub-token
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
HOST=127.0.0.1
PORT=$port
ASTROJS_VERIFY_ORIGIN=http://127.0.0.1:$port
EOF

	(
		cd "$ROOT"
		set -a
		# shellcheck disable=SC1090
		. "$ENV_FILE"
		set +a
		# Astro auto-backgrounds `astro dev` under an agent unless --ignore-lock; stay in the foreground under $pid.
		exec ./node_modules/.bin/astro dev --ignore-lock --host 127.0.0.1 --port "$port"
	) >"$LOG_FILE" 2>&1 </dev/null &
	local pid=$!
	write_state "$pid" "$port" "$stub_pid" "$stub_port"
	wait_ready "$port" "$pid"
	if [ "$want_json" -eq 1 ]; then
		python3 - "$pid" "$port" <<'PY'
import json, sys
pid, port = sys.argv[1], int(sys.argv[2])
print(json.dumps({"pid": pid, "port": port, "origin": f"http://127.0.0.1:{port}", "owned": True}))
PY
	fi
	printf 'launched pid=%s port=%s origin=%s strapi-stub=%s\n' "$pid" "$port" "http://127.0.0.1:${port}" "$stub_port"
}

cmd_doctor() {
	local want_json=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--json) want_json=1; shift ;;
		*) die "unknown doctor flag: $1" ;;
		esac
	done
	load_state
	pid_alive "$PID" || die "recorded pid $PID is dead"
	port_in_use "$PORT" || die "port $PORT is not listening"
	pid_alive "$STUB_PID" || die "recorded Strapi stub pid $STUB_PID is dead"
	port_in_use "$STUB_PORT" || die "Strapi stub port $STUB_PORT is not listening"

	local login_body home_body login_status home_status
	login_body="$(mktemp)"
	home_body="$(mktemp)"
	login_status="$(curl -sS -o "$login_body" -w '%{http_code}' --max-time 10 "$(origin)/login" || true)"
	home_status="$(curl -sS -o "$home_body" -w '%{http_code}' --max-time 10 "$(origin)/" || true)"
	case "$login_status" in
	[1-4][0-9][0-9]) ;;
	*)
		rm -f "$login_body" "$home_body"
		die "GET /login returned $login_status"
		;;
	esac
	grep -q 'Se connecter' "$login_body" || {
		rm -f "$login_body" "$home_body"
		die "GET /login missing Se connecter"
	}
	[ "$home_status" = "200" ] || {
		rm -f "$login_body" "$home_body"
		die "GET / returned $home_status"
	}
	grep -q 'Welcome to Astro' "$home_body" || {
		rm -f "$login_body" "$home_body"
		die "GET / missing Welcome to Astro"
	}
	rm -f "$login_body" "$home_body"

	if [ "$want_json" -eq 1 ]; then
		python3 - "$PID" "$PORT" "$login_status" "$home_status" "$STUB_PORT" <<'PY'
import json, sys
pid, port, login, home, stub = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], int(sys.argv[5])
print(json.dumps({
    "pid": pid,
    "port": port,
    "origin": f"http://127.0.0.1:{port}",
    "strapiStubPort": stub,
    "owned": True,
    "loginStatus": login,
    "homeStatus": home,
}))
PY
		return 0
	fi
	cat <<EOF
pid=$PID
port=$PORT
origin=$(origin)
owned=true
strapi=stub:$STUB_PORT
login=$login_status
home=$home_status
markers=Se connecter,Welcome to Astro
EOF
}

http_get() {
	local method="$1" path="$2" follow="$3"
	local out_body="${4:-}" out_headers="${5:-}"
	load_state
	case "$path" in
	/*) ;;
	*) die "path must start with /" ;;
	esac
	[ "$method" = "GET" ] || die "only GET is supported"

	local target curl_args status location final
	target="$(origin)$path"
	curl_args=(-sS -D - -o /tmp/verify-astrojs-body.$$ --max-time 20)
	if [ "$follow" = "0" ]; then
		curl_args+=(--max-redirs 0)
	else
		curl_args+=(-L)
	fi

	local dump
	dump="$(mktemp)"
	set +e
	curl "${curl_args[@]}" -w '\n__CURL__ %{http_code} %{url_effective}\n' "$target" >"$dump" 2>/tmp/verify-astrojs-curl-err.$$
	local curl_rc=$?
	set -e
	if [ "$follow" = "0" ] && [ "$curl_rc" -eq 47 ]; then
		curl_rc=0
	fi
	[ "$curl_rc" -eq 0 ] || die "curl failed for $target ($(cat /tmp/verify-astrojs-curl-err.$$))"

	status="$(awk '/^__CURL__/ { print $2 }' "$dump" | tail -n 1)"
	final="$(awk '/^__CURL__/ { print $3 }' "$dump" | tail -n 1)"
	# Node/undici emits lowercase "location:"; mawk has no IGNORECASE.
	location="$(awk 'tolower($1)=="location:"{ sub("\r",""); print $2; exit }' "$dump")"

	if [ -n "$out_body" ]; then
		mkdir -p "$(dirname "$out_body")"
		cp /tmp/verify-astrojs-body.$$ "$out_body"
	fi
	if [ -n "$out_headers" ]; then
		mkdir -p "$(dirname "$out_headers")"
		awk '/^__CURL__/ { exit } { print }' "$dump" >"$out_headers"
	fi

	printf 'status=%s\n' "$status"
	printf 'request=%s %s\n' "$method" "$target"
	printf 'final=%s\n' "$final"
	if [ -n "$location" ]; then
		printf 'location=%s\n' "$location"
	fi
	local cache_control
	cache_control="$(awk 'tolower($1)=="cache-control:"{ sub("\r",""); sub(/^[^:]*: */,""); print }' "$dump" | tail -n 1)"
	if [ -n "$cache_control" ]; then
		printf 'cache-control=%s\n' "$cache_control"
	fi
	printf 'markers='
	local hits="" needle
	for needle in \
		'Welcome to Astro' \
		'Se connecter' \
		'Accueil' \
		'Mentions légales' \
		'Politique de confidentialité' \
		'id="cookie-banner"' \
		'id="accept-all-cookies"' \
		'id="email"' \
		'id="password"' \
		'id="passwordConfirmation"' \
		'Mot de passe oublié ?' \
		'Inscrivez-vous' \
		'Connectez-vous' \
		'Page non trouvée' \
		"Retourner à l'accueil" \
		"Retour à l'accueil" \
		'Vous avez oublié votre mot de passe ?' \
		'Réinitialiser mon mot de passe'; do
		if grep -q -F "$needle" /tmp/verify-astrojs-body.$$; then
			if [ -n "$hits" ]; then
				hits="$hits,"
			fi
			hits="${hits}${needle}"
		fi
	done
	# Heading uses U+2019; match it separately so ASCII apostrophe does not hide a miss.
	if grep -q $'S\u2019inscrire' /tmp/verify-astrojs-body.$$ 2>/dev/null || grep -q 'S’inscrire' /tmp/verify-astrojs-body.$$; then
		if [ -n "$hits" ]; then
			hits="$hits,"
		fi
		hits="${hits}S’inscrire"
	fi
	printf '%s\n' "$hits"

	rm -f "$dump" /tmp/verify-astrojs-body.$$ /tmp/verify-astrojs-curl-err.$$
}

cmd_http() {
	local method="" path="" follow=1 body="" headers=""
	while [ $# -gt 0 ]; do
		case "$1" in
		GET|POST) method="$1"; shift ;;
		--no-follow) follow=0; shift ;;
		--follow) follow=1; shift ;;
		--body) body="$2"; shift 2 ;;
		--headers) headers="$2"; shift 2 ;;
		*)
			if [ -z "$path" ]; then
				path="$1"
				shift
			else
				die "unexpected http arg: $1"
			fi
			;;
		esac
	done
	[ -n "$method" ] || die "http needs a method (GET)"
	[ -n "$path" ] || die "http needs a path"
	http_get "$method" "$path" "$follow" "$body" "$headers"
}

cmd_screenshot() {
	local path="" url_path="/"
	while [ $# -gt 0 ]; do
		case "$1" in
		--path) path="$2"; shift 2 ;;
		--url) url_path="$2"; shift 2 ;;
		*) die "unknown screenshot flag: $1" ;;
		esac
	done
	[ -n "$path" ] || die "usage: control-astrojs screenshot --path FILE [--url /path]"
	load_state
	cmd_doctor >/dev/null
	local chrome=""
	for chrome in google-chrome google-chrome-stable chromium chromium-browser /usr/bin/google-chrome; do
		if command -v "$chrome" >/dev/null 2>&1 || [ -x "$chrome" ]; then
			break
		fi
		chrome=""
	done
	[ -n "$chrome" ] || die "no Chrome/Chromium on PATH"
	mkdir -p "$(dirname "$path")"
	local target
	target="$(origin)$url_path"
	local profile="$TMP_DIR/chrome-profile"
	rm -rf "$profile"
	mkdir -p "$profile"
	rm -f "$path"
	local chrome_log="$TMP_DIR/chrome.log"
	timeout 45 "$chrome" --headless=new --disable-gpu --no-sandbox --disable-dev-shm-usage \
		--hide-scrollbars --window-size=1280,800 --virtual-time-budget=8000 \
		--user-data-dir="$profile" --screenshot="$path" "$target" >"$chrome_log" 2>&1 || true
	if [ -s "$path" ]; then
		echo "screenshot: $path ($target)"
		return 0
	fi
	rm -f "$path"
	local profile_old="$TMP_DIR/chrome-profile-old"
	rm -rf "$profile_old"
	mkdir -p "$profile_old"
	timeout 45 "$chrome" --headless --disable-gpu --no-sandbox --disable-dev-shm-usage \
		--hide-scrollbars --window-size=1280,800 \
		--user-data-dir="$profile_old" --screenshot="$path" "$target" >>"$chrome_log" 2>&1 || true
	if [ -s "$path" ]; then
		echo "screenshot: $path ($target) (headless fallback)"
		return 0
	fi
	echo "screenshot: chrome timed out or failed ($target)" >&2
	return 1
}

require_markers() {
	local haystack="$1"
	shift
	local needle
	for needle in "$@"; do
		printf '%s\n' "$haystack" | grep -q -F "$needle" || die "missing marker: $needle"
	done
}

cmd_drive() {
	local feature="${1:-}"
	case "$feature" in
	public-home) drive_public_home ;;
	auth-login) drive_auth_login ;;
	auth-register) drive_auth_register ;;
	lost-password) drive_lost_password ;;
	*) die "drive supports public-home, auth-login, auth-register, lost-password (got ${feature:-empty})" ;;
	esac
}

# Stub reader account, from tests/e2e/accounts.ts.
READER_EMAIL='jean.dupont@example.com'
READER_PASSWORD='Lecteur-2026!'
# Disposable address for register and forgot-password; the stub accepts any email and stores nothing.
VERIFY_EMAIL='verify-astrojs@example.com'
VERIFY_PASSWORD='Verify-2026!x'
# Cloudflare's dummy token. The always-pass test secret from launch accepts it at siteverify;
# an empty token is rejected before siteverify is called.
TURNSTILE_TOKEN='cf-turnstile-response=XXXX.DUMMY.TOKEN.XXXX'

# One request of a scripted round trip, sharing the cookie jar $jar. Writes
# <name>.headers (cookie values redacted) and <name>.html under $out, then
# asserts the status, the Location path when given, and every body marker.
auth_step() {
	local name="$1" method="$2" path="$3" want_status="$4" want_location="$5"
	shift 5
	local markers=() form=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--form) form+=(--data-urlencode "$2"); shift 2 ;;
		*) markers+=("$1"); shift ;;
		esac
	done
	# Astro actions answer 415 to a POST without a form content type, even when the form has no fields.
	if [ "$method" = POST ] && [ "${#form[@]}" -eq 0 ]; then
		form=(--data '')
	fi
	local raw_headers="$TMP_DIR/step.headers" status location
	status="$(curl -sS -X "$method" -b "$jar" -c "$jar" -H "Origin: $(origin)" "${form[@]}" \
		-D "$raw_headers" -o "$out/$name.html" -w '%{http_code}' --max-time 20 "$(origin)$path")" ||
		die "$name: curl failed for $method $path"
	sed -E 's/^([Ss]et-[Cc]ookie: [^=]+=)[^;]*/\1<redacted>/' "$raw_headers" >"$out/$name.headers"
	location="$(awk 'tolower($1)=="location:"{ sub("\r",""); print $2; exit }' "$raw_headers")"
	location="${location#"$(origin)"}"
	rm -f "$raw_headers"
	printf '%s %s %s -> %s%s\n' "$name" "$method" "$path" "$status" "${location:+ $location}" | tee -a "$out/steps.txt"
	[ "$status" = "$want_status" ] || die "$name: expected status $want_status, got $status"
	[ -z "$want_location" ] || [ "$location" = "$want_location" ] ||
		die "$name: expected Location $want_location, got ${location:-none}"
	local needle
	for needle in "${markers[@]}"; do
		grep -q -F "$needle" "$out/$name.html" "$out/$name.headers" || die "$name: missing marker: $needle"
	done
}

# Fresh proof dir and cookie jar for a scripted round trip on the owned instance.
begin_steps() {
	cmd_doctor >/dev/null
	out="$PROOF_DIR/$1"
	jar="$TMP_DIR/$1.jar"
	rm -rf "$out" "$jar"
	mkdir -p "$out"
}

# Writes doctor.txt and manifest.json for a round trip; remaining arguments are the checks.
end_steps() {
	local feature="$1"
	shift
	rm -f "$jar"
	cmd_doctor | tee "$out/doctor.txt" >/dev/null
	python3 - "$out" "$(origin)" "$STUB_PORT" "$feature" "$@" <<'PY'
import json, sys, os, datetime
out, origin, stub, feature, checks = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
steps = open(os.path.join(out, "steps.txt")).read().splitlines()
files = sorted(set(os.listdir(out)) | {"manifest.json"})
payload = {
    "feature": feature,
    "baseUrl": origin,
    "strapi": f"tests/e2e/strapi-stub.ts on 127.0.0.1:{stub}",
    "capturedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "commands": steps,
    "checks": checks,
    "files": files,
}
open(os.path.join(out, "manifest.json"), "w").write(json.dumps(payload, indent=2) + "\n")
PY
	printf 'drove %s evidence=%s\n' "$feature" "$out"
}

drive_auth_login() {
	begin_steps auth-login
	auth_step guard GET /dashboard 302 /login 'private, no-store'
	auth_step turnstile-missing POST '/login?_action=auth.login' 403 '' \
		--form "email=$READER_EMAIL" --form "password=$READER_PASSWORD" \
		'La vérification anti-robot a échoué'
	auth_step wrong-password POST '/login?_action=auth.login' 400 '' \
		--form "email=$READER_EMAIL" --form 'password=not-the-password' --form "$TURNSTILE_TOKEN" \
		'Adresse email ou mot de passe incorrect'
	auth_step login POST '/login?_action=auth.login' 302 /dashboard \
		--form "email=$READER_EMAIL" --form "password=$READER_PASSWORD" --form "$TURNSTILE_TOKEN" \
		'user_token=' 'user_data=' 'user_data_timestamp='
	auth_step dashboard GET /dashboard 200 '' \
		'Mon compte' 'Jean Dupont' "$READER_EMAIL" 'id="logout-button"' 'Informations personnelles'
	auth_step account GET /dashboard/account 200 '' 'Mon profil' 'Jean Dupont'
	auth_step login-when-logged-in GET /login 302 /dashboard
	auth_step logout POST '/dashboard?_action=auth.logout' 302 /login
	auth_step guard-after-logout GET /dashboard 302 /login
	end_steps auth-login \
		"logged-out /dashboard -> 302 /login, Cache-Control private, no-store" \
		"login without a Turnstile token -> 403 with La vérification anti-robot a échoué" \
		"wrong password -> 400 with Adresse email ou mot de passe incorrect" \
		"reader login -> 302 /dashboard, sets user_token, user_data, user_data_timestamp" \
		"/dashboard shows Mon compte, Jean Dupont, logout button; /dashboard/account shows Mon profil" \
		"logged-in /login -> 302 /dashboard" \
		"logout -> 302 /login, then /dashboard -> 302 /login"
}

drive_auth_register() {
	begin_steps auth-register
	auth_step mail-gate GET /register/mail-confirmation 302 /register
	auth_step register-form GET /register 200 '' \
		'S’inscrire' 'id="email"' 'id="password"' 'id="passwordConfirmation"' 'data-turnstile' 'private, no-store'
	auth_step register POST '/register?_action=auth.register' 302 /register/mail-confirmation \
		--form "email=$VERIFY_EMAIL" --form "password=$VERIFY_PASSWORD" \
		--form "passwordConfirmation=$VERIFY_PASSWORD" --form "$TURNSTILE_TOKEN" \
		'mail-confirmation='
	auth_step mail-confirmation GET /register/mail-confirmation 200 '' \
		'Confirmation de votre adresse email' "$VERIFY_EMAIL" 'Renvoyer un mail'
	auth_step resend-mail POST '/register/mail-confirmation?_action=auth.confirmMail' 200 '' \
		--form "email=$VERIFY_EMAIL" --form "$TURNSTILE_TOKEN" \
		'A confirmation email has been sent to your email address.'
	end_steps auth-register \
		"/register/mail-confirmation without cookie -> 302 /register" \
		"/register shows S’inscrire, email and password pair, Turnstile widget" \
		"register -> 302 /register/mail-confirmation, sets mail-confirmation" \
		"/register/mail-confirmation shows the submitted email" \
		"resend -> 200 with A confirmation email has been sent to your email address."
}

drive_lost_password() {
	begin_steps lost-password
	auth_step wait-gate GET /lost-password/wait-mail 302 /lost-password
	auth_step reset-gate GET /lost-password/reset 302 /lost-password
	auth_step forgot-form GET /lost-password 200 '' \
		'Vous avez oublié votre mot de passe ?' 'id="email"' 'Réinitialiser mon mot de passe' "Retour à l'accueil"
	auth_step forgot POST '/lost-password?_action=password.forgotPassword' 302 /lost-password/wait-mail \
		--form "email=$VERIFY_EMAIL" --form "$TURNSTILE_TOKEN" \
		'wait-mail-password='
	auth_step wait-mail GET /lost-password/wait-mail 200 '' 'Email envoyé' "$VERIFY_EMAIL"
	auth_step reset-link GET '/lost-password/reset?code=verify' 302 /lost-password/reset 'password-reset-code='
	auth_step reset-form GET /lost-password/reset 200 '' \
		'Changer votre mot de passe' 'id="passwordConfirmation"' 'Changer mon mot de passe'
	auth_step reset POST '/lost-password/reset?_action=password.resetPassword' 302 /dashboard \
		--form 'code=verify' --form "password=$VERIFY_PASSWORD" \
		--form "passwordConfirmation=$VERIFY_PASSWORD" --form "$TURNSTILE_TOKEN" \
		'user_token=' 'password-reset-code=<redacted>; Path=/; Expires='
	auth_step dashboard GET /dashboard 200 '' 'Mon compte' 'Jean Dupont'
	auth_step logout POST '/dashboard?_action=auth.logout' 302 /login
	end_steps lost-password \
		"/lost-password/wait-mail and /lost-password/reset without cookies -> 302 /lost-password" \
		"/lost-password shows the heading, email field, submit, Retour à l'accueil" \
		"forgot -> 302 /lost-password/wait-mail, sets wait-mail-password; wait-mail shows the email" \
		"/lost-password/reset?code=verify -> 302 /lost-password/reset, sets password-reset-code" \
		"reset -> 302 /dashboard signed in as the stub reader, password-reset-code cleared" \
		"logout -> 302 /login"
}

drive_public_home() {
	cmd_doctor >/dev/null
	local out="$PROOF_DIR/public-home"
	mkdir -p "$out"

	local home_meta not_found_meta
	home_meta="$out/home.meta.txt"
	not_found_meta="$out/not-found.meta.txt"

	http_get GET / 1 "$out/home.html" "$out/home.headers" | tee "$home_meta" >/dev/null
	require_markers "$(cat "$home_meta")" \
		'status=200' \
		'Welcome to Astro' \
		'Accueil' \
		'Mentions légales' \
		'Politique de confidentialité' \
		'id="cookie-banner"' \
		'id="accept-all-cookies"'

	http_get GET /this-page-does-not-exist-verify 1 "$out/not-found.html" "$out/not-found.headers" | tee "$not_found_meta" >/dev/null
	require_markers "$(cat "$not_found_meta")" 'status=404' 'Page non trouvée' "Retourner à l'accueil"

	cmd_doctor | tee "$out/doctor.txt" >/dev/null
	local shot_note="screenshot skipped"
	if cmd_screenshot --path "$out/home.png" --url /; then
		shot_note="screenshot http://127.0.0.1:${PORT}/ -> home.png"
	else
		echo "drive public-home: screenshot skipped (chrome failed or timed out)" >&2
	fi

	python3 - "$out" "$(origin)" "$shot_note" <<'PY'
import json, sys, os, datetime
out, origin, shot = sys.argv[1], sys.argv[2], sys.argv[3]
files = sorted(name for name in os.listdir(out) if name != "manifest.json")
if "manifest.json" not in files:
    files.append("manifest.json")
payload = {
    "feature": "public-home",
    "baseUrl": origin,
    "capturedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "commands": [
        f"GET {origin}/ -> 200",
        f"GET {origin}/this-page-does-not-exist-verify -> 404",
        shot,
    ],
    "checks": [
        "home HTML contains Welcome to Astro, Accueil, Mentions légales, Politique de confidentialité, cookie-banner",
        "missing route HTML contains Page non trouvée",
        "doctor owned=true, /login has Se connecter, / has Welcome to Astro",
    ],
    "files": files,
}
open(os.path.join(out, "manifest.json"), "w").write(json.dumps(payload, indent=2) + "\n")
PY
	printf 'drove public-home evidence=%s\n' "$out"
}

cmd_cleanup() {
	if [ ! -f "$STATE_FILE" ]; then
		printf 'nothing to clean (no state file)\n'
		return 0
	fi
	# shellcheck disable=SC1090
	. "$STATE_FILE"
	if [ -n "${PID:-}" ] && pid_alive "$PID"; then
		stop_pid_tree "$PID"
	fi
	if [ -n "${STUB_PID:-}" ] && pid_alive "$STUB_PID"; then
		stop_pid_tree "$STUB_PID"
	fi
	rm -f "$STATE_FILE" "$PID_FILE" "$ENV_FILE" "$TMP_DIR"/*.jar "$TMP_DIR/step.headers"
	rm -rf "$TMP_DIR/chrome-profile" "$TMP_DIR/chrome-profile-old"
	printf 'cleaned pid=%s port=%s stub-pid=%s evidence=%s\n' "${PID:-none}" "${PORT:-none}" "${STUB_PID:-none}" "$PROOF_DIR"
	[ -d "$PROOF_DIR" ] || die "cleanup deleted evidence at $PROOF_DIR"
}

cmd_self_check() {
	usage >/dev/null
	if [ -f "$STATE_FILE" ]; then
		printf 'self-check: state exists (doctor may be valid)\n'
		return 0
	fi
	set +e
	# die() calls exit; run doctor in a subshell so a missing state file is a
	# non-zero status here instead of aborting self-check.
	( cmd_doctor ) >/tmp/verify-astrojs-self-doctor.$$ 2>/tmp/verify-astrojs-self-doctor-err.$$
	local rc=$?
	set -e
	[ "$rc" -ne 0 ] || die "doctor succeeded without a state file"
	grep -q 'no state file' /tmp/verify-astrojs-self-doctor-err.$$ || die "doctor-without-instance had unexpected error"
	rm -f /tmp/verify-astrojs-self-doctor.$$ /tmp/verify-astrojs-self-doctor-err.$$
	printf 'self-check: ok (help + doctor-without-instance)\n'
}

main() {
	local cmd="${1:-help}"
	if [ $# -gt 0 ]; then
		shift
	fi
	case "$cmd" in
	launch) cmd_launch "$@" ;;
	doctor) cmd_doctor "$@" ;;
	http) cmd_http "$@" ;;
	screenshot) cmd_screenshot "$@" || die "screenshot failed" ;;
	drive) cmd_drive "$@" ;;
	cleanup) cmd_cleanup "$@" ;;
	self-check) cmd_self_check "$@" ;;
	help|-h|--help) usage ;;
	*) die "unknown command: $cmd" ;;
	esac
}

main "$@"
