{
  "name": "astro-template",
  "type": "module",
  "version": "1.4.0",
  "scripts": {
    "prepare": "vp config --no-agent || true",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun ./start.mjs",
    "astro": "astro",
    "test": "vp test",
    "test:e2e": "e2e run",
    "test:e2e:ci": "e2e run --exclude-tag agent --reporter list,junit",
    "upgrade": "bunx @astrojs/upgrade",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon.png"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@sentry/astro": "^11.11.0",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "astro": "^7.4.7",
    "astro-seo": "^1.2.0",
    "astro-seo-schema": "^7.0.1",
    "browser-image-compression": "^2.0.2",
    "cn": "^0.5.2",
    "heic2any": "^0.0.4",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@ai-sdk/xai": "^5.0.40",
    "@astrojs/check": "^0.9.12",
    "@e2e-dev/web": "^0.15.5",
    "@oxlint/plugins": "1.92.0",
    "@playform/compress": "^0.2.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "ai": "^7.0.165",
    "baseline-browser-mapping": "^2.11.35",
    "browserslist": "4.29.5",
    "e2e": "^0.22.0",
    "react-doctor": "^0.9.22",
    "sass": "^1.108.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "update-browserslist-db": "1.3.4",
    "vite-plus": "^1.5.0"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.35",
    "yaml": "^2.9.1",
    "esbuild": "^0.28.2",
    "astro": "^7.4.7",
    "vite": "^8.3.6"
  },
  "trustedDependencies": [
    "core-js",
    "esbuild",
    "sharp"
  ],
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ]
  },
  "packageManager": "bun@1.4.4"
}
